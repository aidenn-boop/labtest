#!/bin/sh
# Run Python 3.13 + numpy for the simulator (and bots that need numpy) without system installs.
# Usage: sim/py sim/run_matches.py ...   |   bot command: "sim/py -u bot/main.py"
if [ -n "$MECH_PY" ] && [ -x "$MECH_PY" ]; then exec "$MECH_PY" "$@"; fi
if python3 -c "import numpy" 2>/dev/null; then exec python3 "$@"; fi
for UV in "$(command -v uv 2>/dev/null)" $HOME/.local/share/mise/installs/uv/*/uv-*/uv $HOME/.local/bin/uv $HOME/.cargo/bin/uv; do
  if [ -x "$UV" ] && "$UV" --version >/dev/null 2>&1; then
    exec "$UV" run --quiet --no-project --python 3.13 --with numpy==2.5.5 python "$@"
  fi
done
echo "sim/py: need numpy (pip install numpy) or uv (https://docs.astral.sh/uv/)" >&2; exit 1
